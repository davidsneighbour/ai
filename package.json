{
  "name": "@davidsneighbour/ai",
  "description": "AI prompts, skills, templates, and workflows f(or|rom) @davidsneighbour.",
  "version": "1.15.0",
  "private": true,
  "bin": {
    "ai": "./scripts/ai.ts",
    "ai-symlink": "./scripts/ai-symlink.ts"
  },
  "dependencies": {
    "twitter-text": "3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@dnbhq/markdownlint-config": "0.2.11",
    "@github/markdownlint-github": "0.8.3",
    "@release-it/conventional-changelog": "12.0.0",
    "@secretlint/secretlint-rule-no-dotenv": "13.0.4",
    "@secretlint/secretlint-rule-no-homedir": "13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.2.0",
    "@types/twitter-text": "3.1.10",
    "cspell": "10.0.1",
    "lint-staged": "17.3.0",
    "lockfile-lint": "5.0.1",
    "markdownlint-cli2": "0.23.2",
    "markdownlint-rule-extended-ascii": "0.2.1",
    "markdownlint-rule-list-duplicates": "0.0.1",
    "markdownlint-rule-relative-links": "5.1.2",
    "markdownlint-rule-search-replace": "1.2.0",
    "markdownlint-rule-title-case-style": "0.4.3",
    "release-it": "21.0.2",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "secretlint": "13.0.4",
    "simple-git-hooks": "2.13.1",
    "smol-toml": "1.8.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2"
  },
  "overrides": {
    "js-yaml": ">=4.2.0",
    "lockfile-lint": {
      "lockfile-lint-api": {
        "@yarnpkg/parsers": {
          "js-yaml": "^3.15.0"
        }
      }
    },
    "markdown-it": "^14.2.0",
    "linkify-it": "^5.0.2"
  },
  "scripts": {
    "ai:check": "node ./scripts/ai.ts check",
    "ai:check:release": "node ./scripts/ai.ts check --release",
    "ai:drift": "node ./scripts/ai.ts drift-report",
    "ai:lint": "node ./scripts/ai.ts lint",
    "ai:list": "node ./scripts/ai.ts list",
    "ai:schemas": "node ./scripts/ai.ts export-schemas",
    "ai:show": "node ./scripts/ai.ts show",
    "ai:validate": "node ./scripts/ai.ts validate",
    "build:documentation": "node ./scripts/ai.ts build-documentation",
    "check": "npm run lint:code && npm run validate:types && npm run ai:check && npm run lint && npm run lint:markdown && npm run test:ai-symlink",
    "hooks:install": "npx simple-git-hooks",
    "install:skills": "npx skills add ./skills --skill '*' --yes",
    "lint": "npm run lint:skills && npm run lint:skills:markdown",
    "lint:code": "biome check scripts",
    "lint:markdown": "markdownlint-cli2 \"**/*.{md,mdx}\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.{md,mdx}\"",
    "lint:skills": "node ./scripts/ai.ts validate-skills --root skills",
    "lint:skills:markdown": "markdownlint-cli2 \"skills/**/*.md\"",
    "lint:skills:verbose": "node ./scripts/ai.ts validate-skills --root skills --verbose",
    "release": "release-it --ci",
    "setup": "node ./scripts/ai.ts setup --prompts",
    "setup:cli": "npm install -g .",
    "setup:prompts": "node ./scripts/ai.ts setup --prompts",
    "setup:prompts:folders": "node ./scripts/ai.ts setup --prompts --mode folders",
    "setup:prompts:glob": "node ./scripts/ai.ts setup --prompts --mode glob",
    "test:ai-symlink": "node --test ./scripts/ai-symlink.test.ts",
    "validate:types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=25"
  },
  "cspell": {
    "version": "0.2",
    "language": "en-GB",
    "dictionaryDefinitions": [
      {
        "name": "custom",
        "path": "./.vscode/cspell/dictionary.txt",
        "addWords": true
      }
    ],
    "dictionaries": [
      "custom"
    ],
    "import": [
      ".vscode/cspell/preferred-terms.json"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run ai:check:release"
  },
  "type": "module"
}
