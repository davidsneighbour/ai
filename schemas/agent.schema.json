{
  "$comment": "Generated from scripts/ai.ts. Do not edit manually.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short description of the sub-agent profile."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name for the sub-agent profile."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "Role this agent plays."
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether this agent profile is enabled."
    },
    "connection-type": {
      "type": "string",
      "minLength": 1
    },
    "argument-hint": {
      "description": "Hint text shown in the chat input field for this agent.",
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "description": "Tools or tool sets available to this agent.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "description": "Subagents that can be delegated to by this agent.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "description": "Language model used by this agent.",
      "type": "string"
    },
    "handoffs": {
      "description": "Agents this agent can hand off to.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "description": "Target surface where this agent is available.",
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "references": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?:\\/\\/"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "description",
    "name",
    "role",
    "enabled"
  ],
  "additionalProperties": false
}
