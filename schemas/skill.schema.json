{
  "$comment": "Generated from scripts/ai.ts. Do not edit manually.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "skill"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strict": {
      "type": "boolean"
    },
    "references": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?:\\/\\/"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "description"
  ],
  "additionalProperties": false
}
